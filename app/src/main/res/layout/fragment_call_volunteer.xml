<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/cardCallVolunteer"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:layout_height="0dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:background="@drawable/bg_blue_card"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivVolunteerIllustration"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eyeconnect_logo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="100dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:lineSpacingExtra="3dp"
                android:text="Luôn có người\nsẵn sàng giúp đỡ bạn"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="Gọi một tình nguyện viên\nđồng hành cùng bạn"
                android:textColor="#DDF7F5"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_volunteer_cta"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Gọi hỗ trợ  ›"
                android:textColor="@color/main"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutSiriSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_siri_suggestion"
        android:gravity="center_vertical"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_voice_icon"
            android:padding="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Trợ lý giọng nói"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_siri_wave"
                app:tint="@color/main"
                tools:ignore="UseAppTint" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mẹo sử dụng"
                android:textColor="@color/main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:text="Dùng trợ lý giọng nói để mở EyeConnect nhanh hơn."
                android:textColor="#455A64"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivCloseSiri"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:contentDescription="Đóng gợi ý"
            android:focusable="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_circle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnMyGroups"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/bg_my_groups"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_voice_icon"
            android:padding="11dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_community"
                app:tint="@color/main"
                tools:ignore="UseAppTint" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Các nhóm của tôi"
                android:textColor="#263238"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kết nối và đồng hành cùng cộng đồng"
                android:textColor="#78858B"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Mở các nhóm"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/main"
            tools:ignore="UseAppTint" />

    </LinearLayout>

</LinearLayout>