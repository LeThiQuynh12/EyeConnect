<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <ImageView
            android:id="@+id/ivSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/bg_speaker"
            android:clickable="true"
            android:contentDescription="Âm thanh"
            android:focusable="true"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_up" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_action_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnCapture"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_capture_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Chụp ảnh"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_history_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Lịch sử"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
